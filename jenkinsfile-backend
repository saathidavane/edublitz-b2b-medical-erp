pipeline {
    agent 'any'

    tools {
        maven 'maven1'
    }

    environment {
        my_aws_credential = credentials('aws-access')
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'dev', url: 'https://github.com/saathidavane/edublitz-b2b-medical-erp.git'
            }
        }

        stage('Build User-service'){
            steps {
                dir('user-service'){
                    sh 'mvn clean package -DskipTests'
                }
            }

            post {
                success {
                    archiveArtifacts artifacts: 'user-service/target/*.jar', fingerprint: true
                }
            }
        }

        stage('SonarQubeAnalysis - user service') {
            steps {
                withSonarQubeEnv('sonar') {
                    dir('user-service') {
                        sh 'mvn sonar:sonar'
                    }

                }
            }
        }
        stage('Build Product-Service') {
            steps {
                dir('product-service') {
                    sh 'mvn clean package -DskipTests'
                }
            }
            post {
                success {
                    archiveArtifacts artifacts: 'product-service/target/*.jar', fingerprint: true
                }
            }
        }

        stage('SonarQubeAnalysis - product service') {
            steps {
                withSonarQubeEnv('sonar') {
                    dir('product-service') {
                        sh 'mvn sonar:sonar'
                    }
                }
            }
        }

        stage('Build Order Service') {
            steps {
                dir('order-service') {
                    sh 'mvn clean package -DskipTests'
                }
            }
            post {
                success {
                    archiveArtifacts artifacts: 'order-service/target/*.jar', fingerprint: true
                }
            }
        }

        stage('SonarQubeAnalysis - order service') {
            steps {
                withSonarQubeEnv('sonar') {
                    dir('order-service') {
                        sh 'mvn sonar:sonar'
                    }
                }
            }
        }

        stage (' Docker Build and Push') {
            steps {
                sh '''
                aws ecr get-login-password --region ap-south-1 | docker login --username AWS --password-stdin 139023233927.dkr.ecr.ap-south-1.amazonaws.com
                docker build -t order-service .
                docker tag order-service:latest 139023233927.dkr.ecr.ap-south-1.amazonaws.com/order-service:latest
                docker push 139023233927.dkr.ecr.ap-south-1.amazonaws.com/order-service:latest

                docker build -t product-service .
                docker tag product-service:latest 139023233927.dkr.ecr.ap-south-1.amazonaws.com/product-service:latest
                docker push 139023233927.dkr.ecr.ap-south-1.amazonaws.com/product-service:latest

                docker build -t user-service .
                docker tag user-service:latest 139023233927.dkr.ecr.ap-south-1.amazonaws.com/user-service:latest
                docker push 139023233927.dkr.ecr.ap-south-1.amazonaws.com/user-service:latest

                docker images
                '''
            }
        }        
    }   
}
